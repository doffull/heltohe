# =============================================================================
# Helvetica MP — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env` et renseigner les valeurs.
#
# ⚠️ DEUX ENDROITS DIFFÉRENTS, NE PAS LES CONFONDRE :
#
#   1. FRONT (ce fichier .env)      → variables VITE_*, embarquées dans le bundle
#                                     donc PUBLIQUES. Jamais de secret ici.
#   2. EDGE FUNCTIONS (Supabase)    → secrets serveur, à déclarer dans le
#                                     dashboard Supabase (Edge Functions →
#                                     Secrets) ou via `supabase secrets set`.
#                                     Ils ne sont JAMAIS lus depuis ce fichier.
#
# Un troisième endroit existe : les clés des passerelles de paiement PayPlug /
# Stripe / Mollie / Klarna vivent EN BASE, dans la table `payment_gateway_secrets`,
# et se renseignent depuis Admin → Paiement & Livraison. Voir PROJECT.md §6.
#
# Détail de l'architecture : PROJECT.md §13.
# =============================================================================


# =============================================================================
# 1. FRONT — variables VITE_* (publiques, incluses dans le bundle)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUIS, l'application ne démarre pas sans
# -----------------------------------------------------------------------------
# Dashboard Supabase → Project Settings → API.
# La "publishable key" (anon key) est publique par conception : elle est protégée
# par les policies RLS. Ne JAMAIS mettre la service_role key ici.
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# Domaine public du site — REQUIS pour le SEO
# -----------------------------------------------------------------------------
# Source unique de toutes les URLs absolues : balises canonical et Open Graph
# (src/components/seo/SeoHead.tsx), og:url de index.html, sitemap.xml et
# robots.txt (générés au build par scripts/generate-seo-files.mjs), et l'aperçu
# de l'éditeur visuel.
#
# Sans slash final. En son absence, le repli est le domaine de production ; il
# est défini à trois endroits qu'il faut garder alignés :
#   src/lib/site.ts                → FALLBACK_SITE_URL
#   scripts/generate-seo-files.mjs → FALLBACK_SITE_URL
#   vite.config.ts                 → siteUrlHtmlPlugin
#
# ⚠️ Cette valeur finit dans l'index Google. Sur un environnement de recette,
# mettre l'URL de recette : sinon les canonical de la recette pointeront vers la
# production.
VITE_SITE_URL=https://helvetica-mp.com

# -----------------------------------------------------------------------------
# PayPal — client ID public : REPLI SANDBOX UNIQUEMENT
# -----------------------------------------------------------------------------
# ⚠️ La configuration PayPal est répartie sur TROIS endroits — ne pas les confondre :
#
#   Client Secret (live + sandbox)  → secrets Supabase, section 2 ci-dessous
#                                     JAMAIS ici, JAMAIS en base
#   Client ID (public)              → base `paypal_config`, avec CETTE variable
#                                     en repli — voir la règle ci-dessous
#   Réglages (environnement, devise,→ base `paypal_config`, via /admin/paypal
#   intent, boutons, webhook_id)
#
# RÈGLE DE PRIORITÉ (src/hooks/usePayPalConfig.ts → activeClientId) :
#
#   const fromDb = environment === 'live' ? clientIdLive : clientIdSandbox;
#   return fromDb || (environment === 'live' ? '' : ENV_PAYPAL_CLIENT_ID);
#
#   → La BASE est prioritaire. Cette variable n'est qu'un repli.
#   → ⚠️ EN LIVE, IL N'Y A AUCUN REPLI : si `client_id_live` est vide en base,
#     le client ID vaut "" et le bouton PayPal ne se charge pas, même si cette
#     variable est renseignée. En live, il FAUT passer par /admin/paypal.
#   → En sandbox, valeur par défaut "test" si tout est vide.
#
# Autrement dit : renseigner cette variable ne sert qu'au développement local en
# sandbox. Pour une vraie mise en production, tout se règle dans /admin/paypal.
#
# ℹ️ PayPlug ne suit PAS le même découpage : sa clé secrète est EN BASE
#    (`payment_gateway_secrets`), saisie depuis Admin → Paiement & Livraison.
VITE_PAYPAL_CLIENT_ID=

# -----------------------------------------------------------------------------
# Google Maps (connecteur Lovable) — optionnel
# -----------------------------------------------------------------------------
# Utilisé par le localisateur de boutiques (/trouver-une-boutique).
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# -----------------------------------------------------------------------------
# Verrou de licence — UNIQUEMENT pour `bun run build:protected`
# -----------------------------------------------------------------------------
# Liste de domaines autorisés, séparés par des virgules. Hors de ces domaines,
# l'application REFUSE DE DÉMARRER (src/lib/licenseGuard.ts).
#
# ⚠️ SI CETTE VARIABLE EST VIDE, LE VERROU EST INACTIF : un build "protégé" sans
#    VITE_LICENSE_DOMAINS ne protège rien.
#
# Toujours autorisés, quoi qu'il arrive : localhost, 127.0.0.1, 0.0.0.0,
# *.lovable.app, *.lovableproject.com, *.lovable.dev
#
# Formats acceptés : exemple.fr · .exemple.fr (+ sous-domaines) · *.exemple.fr
VITE_LICENSE_DOMAINS=

# ⚠️ Mentionnée dans le commentaire d'en-tête de licenseGuard.ts mais JAMAIS LUE
#    par le code aujourd'hui. Laissée ici pour mémoire : la renseigner n'a
#    actuellement aucun effet.
# VITE_LICENSE_KEY=


# =============================================================================
# 2. EDGE FUNCTIONS — secrets Supabase (NE PAS mettre dans ce .env)
# =============================================================================
# À déclarer dans Supabase → Edge Functions → Secrets, ou :
#   supabase secrets set NOM=valeur
#
# Les trois variables SUPABASE_* sont injectées automatiquement par la
# plateforme : rien à faire.
#
#   SUPABASE_URL                     (auto)
#   SUPABASE_ANON_KEY                (auto)
#   SUPABASE_SERVICE_ROLE_KEY        (auto) — contourne RLS, ne jamais exposer
#
# -----------------------------------------------------------------------------
#   SUPABASE_JWT_SECRET
#       Signature/vérification de jeton. Utilisé par : spin-roulette
#
# -----------------------------------------------------------------------------
# IA — une seule clé pour TOUT (passerelle Lovable, protocole OpenAI)
# -----------------------------------------------------------------------------
#   LOVABLE_API_KEY                  ⚠️ LA PLUS SENSIBLE EN COÛT
#       Passerelle https://ai.gateway.lovable.dev — modèles Gemini et GPT.
#       Utilisée par 19 fonctions sur 30 : analyze-product-image, boutique-lookup,
#       contact-chat, crm-send-message, generate-cta-style,
#       generate-product-description, generate-product-video, generate-slide-image,
#       generate-slide-text, image-pose-edit, parse-products-pdf, parse-stock-pdf,
#       product-ai-helpers, recommend-size, send-order-notification,
#       template-from-mockup, verify-customer-info, virtual-tryon, voice-command
#
#       ⚠️ 21 des 30 edge functions sont publiques (verify_jwt = false), dont la
#          génération d'images et de vidéos. Sans limitation de débit, cette clé
#          est le premier poste de facture à surveiller. Voir PROJECT.md §9.
#
# -----------------------------------------------------------------------------
# Paiement PayPal (les secrets ; le client ID public est en section 1)
# -----------------------------------------------------------------------------
#   PAYPAL_LIVE_CLIENT_ID
#   PAYPAL_LIVE_CLIENT_SECRET
#   PAYPAL_SANDBOX_CLIENT_ID
#   PAYPAL_SANDBOX_CLIENT_SECRET
#       Utilisés par : paypal, paypal-webhook
#       Les deux jeux coexistent ; le mode actif se choisit dans Admin → PayPal.
#
#   ℹ️ PayPlug n'utilise PAS de secret d'environnement : sa clé est en base,
#      table `payment_gateway_secrets` (gateway = 'payplug').
#
# -----------------------------------------------------------------------------
# Expédition — Colissimo / La Poste
# -----------------------------------------------------------------------------
#   COLISSIMO_LOGIN
#   COLISSIMO_PASSWORD
#       Compte contrat Colissimo.
#       Utilisés par : colissimo-proxy (points relais), create-colissimo-label
#
#   LAPOSTE_API_KEY
#       API points relais La Poste. Utilisée par : colissimo-proxy
#
# -----------------------------------------------------------------------------
# E-mails et notifications
# -----------------------------------------------------------------------------
#   RESEND_API_KEY
#       Envoi transactionnel. Utilisée par : send-order-confirmation,
#       send-order-notification, crm-send-message
#
#   BREVO_API_KEY
#       Second canal e-mail. Utilisée par : crm-send-message
#
#   TWILIO_API_KEY
#       SMS. Utilisée par : send-order-notification
#
# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
#   GOOGLE_MAPS_API_KEY
#       Clé SERVEUR (distincte de la clé navigateur de la section 1).
#       Utilisée par : boutique-lookup
#
# =============================================================================
# Vérifier ce qui est réellement consommé par le code :
#   grep -rho "import\.meta\.env\.[A-Z_]*" src | sort -u          # front
#   grep -rho "Deno\.env\.get(\"[^\"]*\"" supabase/functions | sort -u   # edge
# =============================================================================
